{
  "name": "omninumerology",
  "version": "1.0.0",
  "private": true,
  "description": "OmniNumerology - multi-system numerological intelligence and real-time decision platform",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "next dev -p 3000",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "next build",
    "export": "node scripts/export.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "start:prod": "node dist/server/index.js",
    "start": "next start -p 3000",
    "start:server": "tsx src/server/index.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@tanstack/react-query": "^5.51.23",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "framer-motion": "^11.3.30",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.427.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.0.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.41",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
