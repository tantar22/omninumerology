# --- STNumerology Environment Template ---

# PostgreSQL connection string (Prisma) — optional; the API degrades gracefully without it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stnumerology?schema=public"

# Redis connection string (caching) — optional; the API degrades gracefully without it.
REDIS_URL="redis://localhost:6379"

# Express API server port
PORT=4000

# Frontend -> backend proxy target used by next.config.mjs during local development
API_PROXY_TARGET="http://localhost:4000"

# Public base URL the browser uses to reach the API.
# Empty = same-origin (local dev proxy, or a reverse proxy in front of both).
# Set this when the API is hosted separately, e.g. https://api.your-backend.example.com
NEXT_PUBLIC_API_BASE=""

# Node runtime
NODE_ENV="development"

# --- Optional AI assistant LLM (OpenAI-compatible) ---
# Provide your own key to enable the LLM layer of the in-app assistant.
# When unset, the assistant answers from its built-in knowledge base only.
USER_LLM_API_KEY="your-api-key-here"
USER_LLM_BASE_URL="https://api.openai.com/v1"
USER_LLM_MODEL="gpt-4o-mini"
